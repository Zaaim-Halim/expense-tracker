<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.BudgetsController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox styleClass="page" spacing="22">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label text="Budgets" styleClass="page-title"/>
        <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="newButton" text="New budget" styleClass="primary"/>
    </HBox>
    <VBox fx:id="rows" styleClass="card" spacing="0"/>
  </VBox>
</ScrollPane>
