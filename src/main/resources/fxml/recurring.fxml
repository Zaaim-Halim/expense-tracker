<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.RecurringController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox styleClass="page" spacing="22">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label text="Recurring" styleClass="page-title"/>
        <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="newButton" text="New recurring" styleClass="primary"/>
    </HBox>
    <VBox fx:id="waitingCard" styleClass="card" spacing="4">
      <Label text="Waiting for you" styleClass="card-title"/>
      <VBox fx:id="waitingRows" spacing="0"/>
    </VBox>
    <VBox styleClass="card" spacing="4">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Bills in the next 30 days" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="billsTotal" styleClass="row-amount"/>
      </HBox>
      <VBox fx:id="billRows" spacing="0"/>
    </VBox>
    <VBox styleClass="card" spacing="4">
      <Label text="Every recurring transaction" styleClass="card-title"/>
      <VBox fx:id="ruleRows" spacing="0"/>
    </VBox>
  </VBox>
</ScrollPane>
