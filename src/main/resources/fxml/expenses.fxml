<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.expensetracker.controller.ExpensesController"
      styleClass="page" spacing="20">
  <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="4" HBox.hgrow="ALWAYS">
      <Label text="Expenses" styleClass="page-title"/>
      <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
    </VBox>
    <Button fx:id="editButton" text="Edit" styleClass="secondary"/>
    <Button fx:id="deleteButton" text="Delete" styleClass="secondary, danger-text"/>
    <Button fx:id="newButton" text="New expense" styleClass="primary"/>
  </HBox>
  <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="dateColumn" text="Date" prefWidth="130" minWidth="110"/>
        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="320" minWidth="160"/>
        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="170" minWidth="130"/>
        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="130" minWidth="100"/>
      </columns>
    </TableView>
  </VBox>
</VBox>
