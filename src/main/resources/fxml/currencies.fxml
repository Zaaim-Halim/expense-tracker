<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.CurrenciesController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox styleClass="page" spacing="22">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label text="Currencies" styleClass="page-title"/>
        <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="currentRatesButton" text="Current rates" styleClass="secondary"/>
      <Button fx:id="newRateButton" text="New rate" styleClass="primary"/>
    </HBox>

    <VBox styleClass="card" spacing="4">
      <Label text="Base currency" styleClass="card-title"/>
      <VBox fx:id="baseRows" spacing="0"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
      <Label text="Exchange rates" styleClass="card-title"/>
      <VBox fx:id="rateRows" spacing="0"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
      <Label text="Converter" styleClass="card-title"/>
      <VBox fx:id="converterRows" spacing="10"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Your own currencies" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="newCurrencyButton" text="New currency" styleClass="secondary"/>
      </HBox>
      <VBox fx:id="customRows" spacing="0"/>
    </VBox>
  </VBox>
</ScrollPane>
