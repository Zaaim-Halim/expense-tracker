<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.AccountsController"
            fitToWidth="true" styleClass="page-scroll">
<VBox styleClass="page" spacing="20">
  <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="4" HBox.hgrow="ALWAYS">
      <Label text="Accounts" styleClass="page-title"/>
      <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
    </VBox>
    <Button fx:id="newButton" text="New account" styleClass="primary"/>
  </HBox>
  <HBox spacing="16" styleClass="stats">
    <VBox styleClass="card, stat-card, stat-accent" spacing="6" HBox.hgrow="ALWAYS">
      <Label text="NET WORTH" styleClass="stat-label"/>
      <Label fx:id="netWorthValue" styleClass="stat-value"/>
      <Label fx:id="netWorthCaption" text="what you have, minus what you owe" styleClass="stat-caption" wrapText="true"/>
    </VBox>
    <VBox styleClass="card, stat-card" spacing="6" HBox.hgrow="ALWAYS">
      <Label text="YOU HAVE" styleClass="stat-label"/>
      <Label fx:id="assetsValue" styleClass="stat-value"/>
      <Label fx:id="assetsCaption" styleClass="stat-caption"/>
    </VBox>
    <VBox styleClass="card, stat-card" spacing="6" HBox.hgrow="ALWAYS">
      <Label text="YOU OWE" styleClass="stat-label"/>
      <Label fx:id="owedValue" styleClass="stat-value"/>
      <Label fx:id="owedCaption" styleClass="stat-caption"/>
    </VBox>
  </HBox>
  <VBox fx:id="historyCard" styleClass="card" spacing="2">
    <HBox alignment="CENTER_LEFT" spacing="10">
      <Label fx:id="historyTitle" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Label fx:id="historyChange" styleClass="row-subtitle"/>
    </HBox>
    <StackPane fx:id="historyChart" prefHeight="190" minHeight="190" maxHeight="190"/>
  </VBox>
  <VBox styleClass="card, list-card">
    <ListView fx:id="list" styleClass="category-list"/>
  </VBox>
</VBox>
</ScrollPane>
