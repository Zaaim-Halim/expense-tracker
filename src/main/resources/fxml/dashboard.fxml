<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.DashboardController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox styleClass="page" spacing="24">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label text="Dashboard" styleClass="page-title"/>
        <Label fx:id="monthLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="newExpenseButton" text="New transaction" styleClass="primary"/>
    </HBox>

    <HBox spacing="16" styleClass="stats">
      <VBox styleClass="card, stat-card, stat-accent" spacing="6" HBox.hgrow="ALWAYS">
        <Label text="SPENT THIS MONTH" styleClass="stat-label"/>
        <Label fx:id="totalValue" styleClass="stat-value"/>
        <Label fx:id="totalCaption" styleClass="stat-caption"/>
      </VBox>
      <VBox styleClass="card, stat-card" spacing="6" HBox.hgrow="ALWAYS">
        <Label text="RECEIVED" styleClass="stat-label"/>
        <Label fx:id="countValue" styleClass="stat-value"/>
        <Label fx:id="countCaption" styleClass="stat-caption"/>
      </VBox>
      <VBox styleClass="card, stat-card" spacing="6" HBox.hgrow="ALWAYS">
        <Label text="SAVED" styleClass="stat-label"/>
        <Label fx:id="topValue" styleClass="stat-value"/>
        <Label fx:id="savedLabel" styleClass="stat-caption"/>
      </VBox>
    </HBox>

    <HBox spacing="16">
      <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS" prefWidth="520">
        <HBox alignment="CENTER_LEFT">
          <Label text="Spending by category" styleClass="card-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="topCategory" styleClass="stat-caption"/>
        </HBox>
        <VBox fx:id="categoryRows" spacing="14"/>
      </VBox>
      <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="420">
        <HBox alignment="CENTER_LEFT">
          <Label text="Recent transactions" styleClass="card-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Button fx:id="showAllButton" text="See all" styleClass="link"/>
        </HBox>
        <VBox fx:id="recentRows" spacing="4"/>
      </VBox>
    </HBox>
    <HBox fx:id="planRow" spacing="16">
      <VBox fx:id="budgetCard" styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="520">
        <HBox alignment="CENTER_LEFT">
          <Label text="Budgets" styleClass="card-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Button fx:id="budgetsButton" text="All budgets" styleClass="link"/>
        </HBox>
        <VBox fx:id="budgetRows" spacing="14"/>
      </VBox>
      <VBox fx:id="comingCard" styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="420">
        <HBox alignment="CENTER_LEFT">
          <Label text="Coming up" styleClass="card-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Button fx:id="recurringButton" text="Recurring" styleClass="link"/>
        </HBox>
        <VBox fx:id="comingRows" spacing="6"/>
      </VBox>
    </HBox>
  </VBox>
</ScrollPane>
