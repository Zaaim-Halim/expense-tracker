<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.ReportsController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox fx:id="page" styleClass="page" spacing="22">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label text="Reports" styleClass="page-title"/>
        <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="pdfButton" text="Save as PDF" styleClass="secondary"/>
    </HBox>
    <HBox fx:id="ranges" styleClass="segmented" maxWidth="-Infinity"/>
    <VBox fx:id="report" spacing="16"/>
  </VBox>
</ScrollPane>
