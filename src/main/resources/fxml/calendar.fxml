<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.expensetracker.controller.CalendarController"
            fitToWidth="true" styleClass="page-scroll">
  <VBox fx:id="page" styleClass="page" spacing="22">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="monthTitle" styleClass="page-title"/>
        <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
      </VBox>
      <Button fx:id="previousButton" styleClass="icon-button"/>
      <Button fx:id="todayButton" text="Today" styleClass="secondary"/>
      <Button fx:id="nextButton" styleClass="icon-button"/>
    </HBox>
    <VBox styleClass="card, calendar-card" spacing="0">
      <GridPane fx:id="grid" styleClass="calendar-grid"/>
    </VBox>
    <VBox fx:id="dayCard" styleClass="card" spacing="8">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="dayTitle" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="dayTotal" styleClass="stat-caption"/>
      </HBox>
      <VBox fx:id="dayRows" spacing="4"/>
    </VBox>
  </VBox>
</ScrollPane>
